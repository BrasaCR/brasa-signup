{
  "name": "brasa-signup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BRASA GovID system — sovereign citizen identity on Cloudflare Workers + D1.",
  "scripts": {
    "test": "node --test",
    "keygen": "node scripts/keygen.js",
    "db:init": "wrangler d1 execute brasa-citizens --file=./schema.sql",
    "db:init:local": "wrangler d1 execute brasa-citizens --local --file=./schema.sql",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "package:staging": "wrangler deploy --config wrangler.staging.jsonc --dry-run --outdir .worker-dry-run",
    "deploy:staging": "wrangler deploy --config wrangler.staging.jsonc",
    "smoke:staging": "node scripts/smoke-staging.mjs"
  },
  "devDependencies": {
    "wrangler": "4.144.0"
  },
  "dependencies": {
    "jose": "^6.1.3"
  }
}
